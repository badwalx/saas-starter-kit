    "react-dom": "^18.3.1",
    "stripe": "^17.3.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
