# ============================================
# SaaS Starter Kit — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# See README.md for setup instructions.

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=YourSaaS

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Configure the webhook endpoint as /api/webhooks/stripe.
# Events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_succeeded, invoice.payment_failed.
# For local testing use the signing secret printed by `stripe listen`.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Stripe Price IDs (test mode) ---
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# --- Coolify Deployment (production only) ---
# COOLIFY_FQDN=your-saas.b7co.in
# DOCKER_BUILDKIT=1
